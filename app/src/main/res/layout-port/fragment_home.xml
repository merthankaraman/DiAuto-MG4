<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/da_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_android_auto" android:importantForAccessibility="no"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="@string/da_brand" android:textSize="26sp" android:textColor="@color/da_text" android:fontFamily="sans-serif-medium"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/exit_button" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="56dp" android:text="@string/da_close" android:textColor="@color/da_muted"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/da_tagline" android:textSize="12sp" android:textColor="@color/da_accent" android:letterSpacing="0.16"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/da_headline" android:textSize="42sp" android:textColor="@color/da_text" android:fontFamily="sans-serif-medium" android:layout_marginTop="14dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/da_description" android:textSize="19sp" android:textColor="@color/da_muted" android:lineSpacingExtra="6dp" android:layout_marginTop="16dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:orientation="vertical" android:padding="24dp" android:background="@drawable/da_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/da_wireless" android:textSize="12sp" android:textColor="@color/da_accent" android:letterSpacing="0.1"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/da_ready" android:textSize="24sp" android:textColor="@color/da_text" android:id="@+id/connection_status" android:accessibilityLiveRegion="polite" android:layout_marginTop="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/wifi_button" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="12dp" android:text="@string/da_connect" android:textSize="18sp" android:textAllCaps="false" android:gravity="center" android:textColor="@color/da_background" app:backgroundTint="@color/da_accent" app:cornerRadius="20dp" app:icon="@drawable/ic_android_auto" app:iconTint="@color/da_background" app:iconGravity="textStart" app:iconPadding="12dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/da_hint" android:textSize="15sp" android:textColor="@color/da_muted" android:layout_marginTop="12dp" android:lineSpacingExtra="4dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/gesture_hint" android:textSize="15sp" android:textColor="@color/da_muted" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp"/>
            </LinearLayout>
            <ImageView android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="20dp" android:src="@drawable/ic_android_auto" android:importantForAccessibility="no"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/usb_button" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="12dp" android:text="@string/da_usb" android:textSize="18sp" android:textAllCaps="false" android:gravity="center" android:textColor="@color/da_text" app:backgroundTint="@color/da_surface" app:cornerRadius="20dp" app:icon="@drawable/ic_usb_white" app:iconTint="@color/da_accent" app:iconGravity="textStart" app:iconPadding="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/da_usb_hint" android:textSize="14sp" android:textColor="@color/da_muted" android:gravity="center" android:layout_marginTop="6dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/settings_button" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="12dp" android:text="@string/da_settings" android:textSize="18sp" android:textAllCaps="false" android:gravity="center" android:textColor="@color/da_text" app:backgroundTint="@color/da_surface" app:cornerRadius="20dp" app:icon="@drawable/ic_settings_white" app:iconTint="@color/da_accent" app:iconGravity="textStart" app:iconPadding="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/da_settings_hint" android:textSize="14sp" android:textColor="@color/da_muted" android:gravity="center" android:layout_marginTop="6dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
