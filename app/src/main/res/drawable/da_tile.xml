<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#22314A"/>
            <corners android:radius="28dp"/>
            <stroke android:width="1dp" android:color="@color/da_accent"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/da_surface"/>
            <corners android:radius="28dp"/>
            <stroke android:width="1dp" android:color="@color/da_border"/>
        </shape>
    </item>
</selector>
