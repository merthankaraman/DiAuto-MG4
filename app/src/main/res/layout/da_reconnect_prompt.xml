<?xml version="1.0" encoding="utf-8"?>
<!-- Over Android Auto after a setting that only applies on the next connection: two big buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/da_scrim"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxWidth="1100dp"
        android:text="@string/reconnect_prompt"
        android:textColor="@color/da_text"
        android:textSize="30sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/reconnect_now"
            android:layout_width="520dp"
            android:layout_height="260dp"
            android:background="@drawable/da_tile"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_refresh_white"
                android:tint="@color/da_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/reconnect_now"
                android:textColor="@color/da_text"
                android:textSize="32sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reconnect_later"
            android:layout_width="520dp"
            android:layout_height="260dp"
            android:layout_marginStart="48dp"
            android:background="@drawable/da_tile"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_close_white"
                android:tint="@color/da_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/reconnect_later"
                android:textColor="@color/da_text"
                android:textSize="32sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
