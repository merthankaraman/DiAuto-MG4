<?xml version="1.0" encoding="utf-8"?>
<!-- First-start tutorial: a picture on the left, the step's text on the right, buttons below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/da_background"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="20dp"
    android:paddingEnd="32dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/da_card">

            <com.andrerinas.openheadunit.main.GestureDemoView
                android:id="@+id/tuto_demo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="16dp" />

            <ImageView
                android:id="@+id/tuto_icon"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:tint="@color/da_accent" />
        </FrameLayout>

        <!-- Scrolls only when a language's text is longer than the screen. -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="36dp"
            android:layout_weight="3"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tuto_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/da_accent"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tuto_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/da_text"
                android:textSize="38sp" />

            <TextView
                android:id="@+id/tuto_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/da_muted"
                android:textSize="23sp" />
        </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tuto_skip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/tuto_skip"
            android:textColor="@color/da_muted"
            android:textSize="24sp" />

        <LinearLayout
            android:id="@+id/tuto_dots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/tuto_back"
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="20dp"
            android:background="@drawable/da_tile"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tuto_back"
                android:textColor="@color/da_text"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tuto_next"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:background="@drawable/da_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:id="@+id/tuto_next_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/da_background"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
