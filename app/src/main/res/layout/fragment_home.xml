<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/da_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="20dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/da_brand"
                android:textColor="@color/da_text"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exit_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="88dp"
                android:text="@string/da_close"
                android:textAllCaps="false"
                android:textColor="@color/da_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.95"
                android:orientation="vertical"
                android:paddingEnd="36dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/da_tagline"
                    android:textColor="@color/da_accent"
                    android:textSize="12sp"
                    android:letterSpacing="0.16" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/da_headline"
                    android:textColor="@color/da_text"
                    android:textSize="40sp"
                    android:lineSpacingMultiplier="0.96" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/da_description"
                    android:textColor="@color/da_muted"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.05"
                android:orientation="vertical"
                android:padding="22dp"
                android:background="@drawable/da_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/da_wireless"
                    android:textColor="@color/da_accent"
                    android:textSize="11sp"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/connection_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/da_ready"
                    android:textColor="@color/da_text"
                    android:textSize="21sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wifi_button"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/da_connect"
                    android:textAllCaps="false"
                    android:textColor="@color/da_background"
                    android:textSize="17sp"
                    app:backgroundTint="@color/da_accent"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_android_auto"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="@color/da_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/da_hint"
                    android:textColor="@color/da_muted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/gesture_hint"
                    android:textColor="@color/da_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/usb_button"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/da_usb"
                android:textAllCaps="false"
                android:textColor="@color/da_text"
                android:textSize="15sp"
                app:backgroundTint="@color/da_surface"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_usb_white"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/da_accent"
                app:strokeColor="@color/da_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_button"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/da_settings"
                android:textAllCaps="false"
                android:textColor="@color/da_text"
                android:textSize="15sp"
                app:backgroundTint="@color/da_surface"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_settings_white"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/da_accent"
                app:strokeColor="@color/da_border"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
