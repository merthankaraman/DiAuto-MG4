<?xml version="1.0" encoding="utf-8"?>
<!-- Two-finger menu over Android Auto: two big buttons; a tap elsewhere closes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/da_scrim"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/menu_disconnect"
            android:layout_width="520dp"
            android:layout_height="300dp"
            android:background="@drawable/da_tile_danger"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_stop"
                android:tint="#FF6B6B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/menu_disconnect"
                android:textColor="@color/da_text"
                android:textSize="32sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_settings"
            android:layout_width="520dp"
            android:layout_height="300dp"
            android:layout_marginStart="48dp"
            android:background="@drawable/da_tile"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings_white"
                android:tint="@color/da_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/da_settings"
                android:textColor="@color/da_text"
                android:textSize="32sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_trip"
            android:layout_width="520dp"
            android:layout_height="300dp"
            android:layout_marginStart="48dp"
            android:background="@drawable/da_tile"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_da_charging"
                android:tint="@color/da_accent" />

            <TextView
                android:id="@+id/menu_trip_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/trip_start"
                android:textColor="@color/da_text"
                android:textSize="32sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/menu_close_hint"
        android:textColor="@color/da_muted"
        android:textSize="28sp" />
</LinearLayout>
