<?xml version="1.0" encoding="utf-8"?>
<!-- MG4 / system UID — must be platform-signed (see scripts/build_mg4.ps1). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system">

    <!-- Match the working DiPlay MG4 package: the platform-signed car build must
         be able to claim/manage the projection phone on the head unit USB bus. -->
    <uses-permission
        android:name="android.permission.MANAGE_USB"
        tools:ignore="ProtectedPermissions" />

    <!-- Silent OTA install on platform-signed system UID (avoids OEM "parse package" UI). -->
    <uses-permission
        android:name="android.permission.INSTALL_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.DELETE_PACKAGES"
        tools:ignore="ProtectedPermissions" />

    <!-- Runtime-stop OEM AllGo / caradapter while DiAuto is running (never pm-disable). -->
    <uses-permission
        android:name="android.permission.FORCE_STOP_PACKAGES"
        tools:ignore="ProtectedPermissions" />

    <application>
    </application>
</manifest>
